n = 0
second = 0
minute = 0
hour = 0

n = int(input("Введите количество секунд меньше 24 часов в целочисленном типе и положительном значении: "))

print("\n" + f"Введенное число: {n}") 

if n >= 0 and n <= 24 * 3600:
    
    hour = int(n / 3600)
    minute = int(n / 60 - hour * 60)
    second = n - (3600 * hour + 60 * minute)
    
    if minute < 10:
        minute = '0' + str(minute)
    
    if second < 10:
        second = '0' + str(second)
        
    print("\n" + f"Результат: {hour}:{minute}:{second}") 
else:
    print("\n" + "Введено некорректное число")
    


