using System;
public class Task4 
{
    public static void Main() 
    {
        
        Console.WriteLine("Введите значение коэффициента a:");
        double a = Convert.ToDouble(Console.ReadLine());
        Console.WriteLine("Введите значение коэффициента b:");
        double b = Convert.ToDouble(Console.ReadLine());
        Console.WriteLine("Введите значение коэффициента c:");
        double c = Convert.ToDouble(Console.ReadLine());
        double d = b * b - 4 * a * c;
        double rootOne = 0;
        double rootTwo = 0;
        
        if (d < 0)
        {
            Console.WriteLine("\n" + "Действительных корней нет");
        } 
        
        if (d == 0)
        {
            rootOne = -b / 2 * a;
            Console.WriteLine("\n" + "Уравнение имеет один действительный корень: " + rootOne);
        }
        
        if (d > 0)
        {
            rootOne = -b + Math.Sqrt(d);
            rootTwo = -b - Math.Sqrt(d);
            Console.WriteLine("\n" + "Уравнение имеет два действительных корня:" + "\n" + "x1: " + rootOne + "\n" + "x2: " + rootTwo);
        }
    }
}

using System;
public class Task5 
{
    public static void Main() 
    {
        Console.WriteLine("Введите год:");
        int year = Convert.ToInt32(Console.ReadLine());

        if (year > 0 && year % 4 == 0 && year % 100 != 0)
        {
            Console.WriteLine("\n" + "Введенный год является високосным");
        }
        else
        {
            if (year > 0 && year % 400 == 0)
            {
                Console.WriteLine("\n" + "Введенный год является високосным");
            }
            else
            {
                Console.WriteLine("\n" + "Введенный год не является високосным");
            }
        }
    }
}

