using System;				
class Task1
{
	static void Main()
	{	
		int second = 0;
		int minute = 0;
		int hour = 0;

		Console.WriteLine("Введите количество секунд меньше 24 часов в целочисленном типе и положительном значении:");
		double input = Convert.ToDouble(Console.ReadLine());
		
		if (input >= 0 && input <= 86400)
		{
			hour = Convert.ToInt32(input / 3600);
			minute = Convert.ToInt32(input / 60 - hour * 60);
			second = Convert.ToInt32(input - (3600 * hour + 60 * minute));
			
			if (minute < 10)
			{
				Convert.ToString(minute);
				minute = '0' + minute;
			}	
			
			if (second < 10)
			{
				Convert.ToString(second);
				minute = '0' + second;
			}
			
			Console.WriteLine("\n" + "Результат: " + hour + ':' + minute + ':' + second);
		}
		else
		{
			Console.WriteLine("\n" + "Введено некорректное число");
		}
	}
}

using System;				
class Task2
{
	static void Main()
	{	
		double n = 3;
		double arithmetic = 0; 
		double geometric = 0;

		Console.WriteLine.("Введите значение a:");
		double a = Convert.ToDouble(Console.ReadLine());
		Console.WriteLine.("Введите значение b:");
		double b = Convert.ToDouble(Console.ReadLine());
		Console.WriteLine.("Введите значение c:");
		double c = Convert.ToDouble(Console.ReadLine());
		
		arithmetic = (a + b + c) / n;
		
		if (a >= 0 && b >= 0 && c >= 0)
		{
			geometric = Math.Pow(a * b * c, 1.0 / n);
			Console.WriteLine("Среднее арифметическое: " + arithmetic + ", Среднее геометрическое: " + geometric);
		}
		else
		{
			Console.WriteLine("Среднее арифметическое: " + arithmetic);
		}
	}
}

